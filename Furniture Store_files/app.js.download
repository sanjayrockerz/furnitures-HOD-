// Replace this catalogue with the customer's products, images and prices.
const catalogue = [
  {id:'sofa', name:'Milan Sofa Set 3+2 Seater - Fabric', category:'Sofa Sets', price:44900, mrp:53000, image:'photo-1555041469-a586c61ea9bc', description:'A generously proportioned sofa set with soft fabric upholstery and supportive cushions.'},
  {id:'bed', name:'Oakwood King Size Storage Bed', category:'Beds', price:44900, mrp:49900, image:'photo-1505693416388-ac5ce068fe85', description:'A warm and welcoming bedroom centrepiece with a practical storage base.'},
  {id:'dining', name:'Haven Dining Table Set - 6 Seater', category:'Dining Table Sets', price:49900, mrp:57000, image:'photo-1618220179428-22790b461013', description:'A spacious dining set designed for everyday meals and special gatherings.'},
  {id:'chair', name:'Comfort High Back Office Chair', category:'Chairs', price:11000, mrp:11690, image:'photo-1505843490701-5be5d4b1a6a5', description:'An adjustable chair for a more comfortable working day.'},
  {id:'recliner', name:'Cloud Fabric Recliner', category:'Recliners', price:28500, mrp:35700, image:'photo-1567538096630-e0c55bd6374c', description:'A comfortable lounge chair for the moments you want to slow down.'},
  {id:'table', name:'Willow Wooden Center Table', category:'Center Tables', price:5600, mrp:5990, image:'photo-1499933374294-4584851497cc', description:'A versatile centre table with a clean, timeless finish.'},
  {id:'tv', name:'Modular Entertainment Unit', category:'TV Stands and Wall Units', price:22300, mrp:24790, image:'photo-1600210492486-724fe5c67fb0', description:'A streamlined media unit with storage for your living room.'},
  {id:'wardrobe', name:'Classic Storage Wardrobe', category:'Wardrobes', price:28700, mrp:31900, image:'photo-1558997519-83ea9252edf8', description:'Roomy everyday storage in a simple contemporary style.'}
];
const categoryList = ['Recliners','Beds','Dining Table Sets','Sofa Sets','Chairs','TV Stands and Wall Units','Office Tables','Center Tables','Study and Computer Tables','Wardrobes','Mattresses','Modular Furniture'];
const fallbackImages = ['photo-1567538096630-e0c55bd6374c','photo-1505693416388-ac5ce068fe85','photo-1618220179428-22790b461013','photo-1555041469-a586c61ea9bc','photo-1505843490701-5be5d4b1a6a5','photo-1600210492486-724fe5c67fb0','photo-1497366754035-f200968a6e72','photo-1499933374294-4584851497cc','photo-1497366811353-6870744d04b2','photo-1558997519-83ea9252edf8','photo-1505693416388-ac5ce068fe85','photo-1556912173-3bb406ef7e77'];
const img=(id,w=800)=>'https://images.unsplash.com/'+id+'?auto=format&fit=crop&w='+w+'&q=80';
const money=n=>'₹ '+n.toLocaleString('en-IN');
const discount=p=>Math.round((1-p.price/p.mrp)*100);
const app=document.querySelector('#app');
const categoryTiles=(list=categoryList)=>list.map(n=>{const i=categoryList.indexOf(n);return '<a href="#category/'+encodeURIComponent(n)+'"><img src="'+img(fallbackImages[i])+'" alt=""><span>'+n+'</span></a>'}).join('');
const card=p=>'<article class="product-card"><a href="#product/'+p.id+'" class="product-image"><img src="'+img(p.image)+'" alt="'+p.name+'"><span class="new-badge">New</span></a><button class="wish" aria-label="Save '+p.name+'" data-wish="'+p.id+'">♡</button><a class="product-title" href="#product/'+p.id+'">'+p.name+'</a><div class="price"><b>'+money(p.price)+'</b> <del>MRP '+money(p.mrp)+'</del> <span>('+discount(p)+'% Off)</span></div></article>';
const cards=list=>list.map(card).join('');
const sectionHead=(title,sub,link)=>'<div class="heading"><div><h2>'+title+'</h2><p>'+sub+'</p></div><a class="outline-button" href="#category/'+encodeURIComponent(link||'All Products')+'">EXPLORE '+title.toUpperCase()+'　❯</a></div>';
function home(){return '<div class="hero"><div class="hero-main"><div class="hero-overlay"><small>MAKE YOUR HOME BEAUTIFUL</small><h1>Comfort for<br><em>every moment</em></h1><p>Discover furniture made for living</p><a href="#category/All%20Products">EXPLORE NOW →</a></div><button class="hero-arrow left" aria-label="Previous slide">‹</button><button class="hero-arrow right" aria-label="Next slide">›</button><span class="counter">● ● ● ● ●　 <span id="slide-number">01</span>/05</span></div><div class="hero-side"><a href="#category/Recliners" class="promo"><div><small>THE COMFORT EVENT</small><b>BIG<br>HOME<br>SALE</b><span>Explore offers →</span></div></a><a href="#category/Dining%20Table%20Sets" class="video"><span class="play">▶</span><b>Dining<br><small>Made for gathering</small></b></a></div></div><section class="collections"><h2>Our Collections</h2><div class="categories">'+categoryTiles()+'</div></section><div class="wide-banner"><div><small>COMFORT MEETS STYLE</small><h2>Make yourself at home</h2><p>Discover our latest sofa collection</p><a href="#category/Sofa%20Sets">SHOP SOFAS →</a></div></div><section>'+sectionHead('New Arrivals','Explore Our New Collections','All Products')+'<div class="products">'+cards(catalogue)+'</div></section><div class="service-banner"><strong>DESIGNED FOR EVERYDAY LIVING</strong><span>Comfort　 •　 Quality　 •　 Care</span></div><section><div class="heading"><h2>Collection</h2><a class="outline-button" href="#category/All%20Products">EXPLORE COLLECTION　❯</a></div><div class="collection-banner"><div>Thoughtfully designed<br><strong>for your home.</strong></div></div></section><section>'+sectionHead('Best Sellers of the Season','Don’t Miss the Best Sellers','All Products')+'<div class="products">'+cards([...catalogue].reverse())+'</div></section><section><h2 class="center">Our Showrooms Across India</h2><p class="center">Find furniture for every room at a showroom near you.</p><div class="cities"><div>Bangalore</div><div>Chennai</div><div>Hyderabad</div><div>Kolkata</div></div></section><section>'+sectionHead('Modular Kitchen','Create a kitchen made for you','Modular Furniture')+'<div class="kitchens"><div>L-Shape</div><div>U-Shape</div><div>Island</div><div>Straight line</div><div>Parallel</div><div>Peninsula</div></div></section>'}
function category(name){const exact=catalogue.filter(p=>p.category===name);const list=exact.length?exact:catalogue;return '<section class="category-page"><p class="crumb"><a href="#home">Home</a>　›　'+name+'</p><div class="category-intro"><h1>'+name+'</h1><p>'+list.length+' Products</p><p>Find furniture for the way you live</p></div><div class="coupon-banner"><b>FURNITURE FOR EVERY HOME</b><span>Explore our collection and find your favourite</span></div><div class="categories compact">'+categoryTiles()+'</div><div class="filterbar"><b>Filters</b><label>Price <select id="price-filter"><option value="all">All prices</option><option value="under">Under ₹25,000</option><option value="over">₹25,000 and above</option></select></label><label>Sort by <select id="sort"><option value="recommended">Recommended</option><option value="low">Price: Low to High</option><option value="high">Price: High to Low</option></select></label></div><div class="products product-grid" id="catalogue-grid">'+cards(list)+'</div><p class="center muted">Showing '+list.length+' products</p></section>'}
function product(id){const p=catalogue.find(x=>x.id===id)||catalogue[0];return '<section class="product-page"><p class="crumb"><a href="#home">Home</a>　›　<a href="#category/'+encodeURIComponent(p.category)+'">'+p.category+'</a>　›　'+p.name+'</p><div class="detail"><div><div class="detail-main"><img id="main-image" src="'+img(p.image,1400)+'" alt="'+p.name+'"></div><div class="thumbs"><button class="active" aria-label="Show product image"><img src="'+img(p.image,300)+'" alt=""></button></div></div><div class="detail-info"><h1>'+p.name+'</h1><p>SKU: SAMPLE-'+p.id.toUpperCase()+'</p><div class="product-actions"><label><input type="checkbox"> Compare</label><button data-wish="'+p.id+'">♡　Add to Wishlist</button><button id="share">♧　Share</button></div><div class="detail-price"><strong>'+money(p.price)+'</strong> <del>MRP '+money(p.mrp)+'</del> <b>('+discount(p)+'% Off)</b> <span>Save '+money(p.mrp-p.price)+'</span><p>Inclusive of all taxes</p></div><div class="detail-offer"><small>FIND YOUR PERFECT PIECE</small><strong>FURNITURE FOR EVERY ROOM</strong></div><div class="delivery-check"><p>Delivery</p><label for="pincode">Enter your pincode</label><div><input id="pincode" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit pincode"><button id="check-pin">CHECK</button></div><p id="pin-result" class="muted">Delivery availability will be confirmed by the store.</p></div><div class="store-box"><h3>⌖　Visit Our Nearest Experience Store</h3><p>Store details will be added for your business.</p></div><div class="service-info"><span>🚚　Ships in<br>　　 Contact store</span><span>♧　Warranty<br>　　 Details available in store</span></div><div class="buy-row"><label>Qty <input id="qty" type="number" min="1" max="10" value="1"></label><button id="add-cart" data-id="'+p.id+'">Add to Cart</button></div><p class="muted">Sample catalogue: prices and availability are placeholders.</p></div></div><div class="product-description"><h2>Product information</h2><details open><summary>Overview</summary><p>'+p.description+'</p></details><details><summary>Product Details</summary><p>Dimensions, material, finish and warranty can be supplied by the customer.</p></details><details><summary>Material & Care</summary><p>Care instructions will be added for the selected product.</p></details></div>'+sectionHead('You May Also Like','Explore more furniture','All Products')+'<div class="products">'+cards(catalogue.filter(x=>x.id!==p.id))+'</div></section>'}
function render(){let [route,arg]=location.hash.slice(1).split('/');arg=decodeURIComponent(arg||'All Products');if(route==='category'){app.innerHTML=category(arg);const exact=catalogue.filter(p=>p.category===arg);const source=exact.length?exact:catalogue;function update(){let list=source.filter(p=>document.querySelector('#price-filter').value==='all'||(document.querySelector('#price-filter').value==='under'?p.price<25000:p.price>=25000));let sort=document.querySelector('#sort').value;if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);document.querySelector('#catalogue-grid').innerHTML=cards(list)||'<p>No products match this filter.</p>'}document.querySelector('#price-filter').onchange=update;document.querySelector('#sort').onchange=update;}else if(route==='product')app.innerHTML=product(arg);else app.innerHTML=home();window.scrollTo(0,0)}
window.addEventListener('hashchange',render);render();
document.addEventListener('click',e=>{const w=e.target.closest('[data-wish]');if(w){w.classList.toggle('selected');w.setAttribute('aria-pressed',w.classList.contains('selected'));}if(e.target.id==='check-pin'){const v=document.querySelector('#pincode').value;document.querySelector('#pin-result').textContent=/^\d{6}$/.test(v)?'Please contact the store to confirm delivery for '+v+'.':'Please enter a valid 6-digit pincode.'}if(e.target.id==='add-cart'){e.target.textContent='Added to sample cart';}if(e.target.id==='share'){navigator.clipboard?.writeText(location.href);e.target.textContent='Link copied';}if(e.target.matches('.hero-arrow')){const n=document.querySelector('#slide-number');n.textContent=String((Number(n.textContent)%5)+1).padStart(2,'0')}});
document.querySelector('#search').addEventListener('keydown',e=>{if(e.key==='Enter')location.hash='category/All%20Products'});document.querySelector('#location').addEventListener('click',()=>{let p=prompt('Enter your delivery pincode');if(p&&/^\d{6}$/.test(p))document.querySelector('#location').textContent=p});
